#version 450 core
#define MAX_OBJECTS 32

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D gPosition;
layout(r32f, binding = 1) uniform image2D shadowMask;

uniform vec3 lightPos;

uniform vec3 lightCenter;
uniform vec3 lightRight;
uniform vec3 lightUp;

const vec2 samples[32] = vec2[](
    vec2(-0.4375, -0.375),
    vec2(-0.3125, -0.375),
    vec2(-0.1875, -0.375),
    vec2(-0.0625, -0.375),
    vec2( 0.0625, -0.375),
    vec2( 0.1875, -0.375),
    vec2( 0.3125, -0.375),
    vec2( 0.4375, -0.375),

    vec2(-0.4375, -0.125),
    vec2(-0.3125, -0.125),
    vec2(-0.1875, -0.125),
    vec2(-0.0625, -0.125),
    vec2( 0.0625, -0.125),
    vec2( 0.1875, -0.125),
    vec2( 0.3125, -0.125),
    vec2( 0.4375, -0.125),

    vec2(-0.4375,  0.125),
    vec2(-0.3125,  0.125),
    vec2(-0.1875,  0.125),
    vec2(-0.0625,  0.125),
    vec2( 0.0625,  0.125),
    vec2( 0.1875,  0.125),
    vec2( 0.3125,  0.125),
    vec2( 0.4375,  0.125),

    vec2(-0.4375,  0.375),
    vec2(-0.3125,  0.375),
    vec2(-0.1875,  0.375),
    vec2(-0.0625,  0.375),
    vec2( 0.0625,  0.375),
    vec2( 0.1875,  0.375),
    vec2( 0.3125,  0.375),
    vec2( 0.4375,  0.375)
);

uniform int objectCount;
uniform mat4 objectModels[MAX_OBJECTS];

// Ray-AABB intersection (slab metoda)
bool intersectAABB(vec3 ro, vec3 rd, vec3 bmin, vec3 bmax, out float tHit) {
    vec3 invRd = 1.0 / rd;
    vec3 t0 = (bmin - ro) * invRd;
    vec3 t1 = (bmax - ro) * invRd;
    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);
    float tEnter = max(max(tMin.x, tMin.y), tMin.z);
    float tExit  = min(min(tMax.x, tMax.y), tMax.z);
    tHit = tEnter;
    return tExit > max(tEnter, 0.0);
}

bool intersectBox( vec3 rayOrigin, vec3 rayDir, mat4 model, out float tHit){
    mat4 invModel = inverse(model);
    vec3 localOrigin = (invModel * vec4(rayOrigin, 1.0)).xyz;
    vec3 localDir = normalize((invModel * vec4(rayDir, 0.0)).xyz);
    return intersectAABB(localOrigin, localDir, vec3(-0.5), vec3(0.5), tHit);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(shadowMask);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec3 fragPos = texelFetch(gPosition, pixel, 0).xyz;

    float visibility = 0.0;

    for(int s = 0; s < 32; s++)
    {
        vec3 samplePos = lightCenter + samples[s].x * lightRight + samples[s].y * lightUp;

        vec3 toLight = samplePos - fragPos;
        float lightDist = length(toLight);
        vec3 rayDir = normalize(toLight);

        vec3 rayOrigin = fragPos + rayDir * 0.02;

        bool blocked = false;
        float tHit;

        for(int i = 0; i < objectCount; i++)
        {
            if(intersectBox(rayOrigin, rayDir, objectModels[i], tHit) && tHit < lightDist)
            {
                blocked = true;
                break;
            }
        }

        if(!blocked)
            visibility += 1.0;
    }

    visibility /= 32.0;

    imageStore(shadowMask, pixel, vec4(visibility, 0.0, 0.0, 1.0));
}