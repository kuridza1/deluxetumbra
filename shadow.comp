#version 450 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0)
uniform sampler2D gPosition;

layout(r32f, binding = 1)
uniform image2D shadowMask;

uniform vec3 lightPos;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    ivec2 size = imageSize(shadowMask);

    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec3 position = texelFetch(gPosition, pixel, 0).xyz;

    float visibility = float(pixel.x) / float(size.x);

    imageStore( shadowMask, pixel, vec4(visibility, 0.0, 0.0, 1.0));
}